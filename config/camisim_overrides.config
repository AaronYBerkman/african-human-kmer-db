// Nextflow override config for CAMISIM's metagenomic pipeline, applied
// additively via `-c` on top of CAMISIM's own pipelines/metagenomic/config/
// metagenomic.config (which still loads normally - this file only changes
// the params below, see scripts/titration_gen/14_run_camisim.sh for the documented rationale of
// each one).
//
// Path-dependent params (genome_locations_file, metadata_file, outdir,
// ncbi_taxdump_file) are deliberately NOT set here - they're passed as CLI
// --param flags from scripts/titration_gen/14_run_camisim.sh, computed from this repo's own
// location, so this config (and the repo) stay portable to wherever it's
// actually cloned. Only fixed design choices live here.
//
// distribution_files is the one exception that must stay a plain config
// value rather than a CLI flag: passing an empty string via
// `--distribution_files ""` gets type-coerced by Nextflow's CLI parser into
// something that breaks `params.distribution_files.isEmpty()` in
// metagenomic.nf (line 68) with "Missing process or function isEmpty()".
// Setting it here as a real Groovy string literal avoids that.
params {
    // empty -> CAMISIM calculates a fresh log-normal distribution for our
    // genomes instead of using the bundled 2-genome toy distribution files
    distribution_files = ""

    size = 0.2
    number_of_samples = 1
    seed = 632741178

    // raw reads only - no pooled gold-standard-assembly/binning output needed
    pooled_gsa = false
    anonymization = false
}
